# ============================================================
# RoleRoute Backend — Environment Variables
# ============================================================
# Copy this file to .env before running the backend:
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ============================================================

# SQLite database file (created automatically on first run)
DATABASE_URL=sqlite:///./roleroute.db

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Hackathon MVP uses a single demo student
DEMO_USER_ID=1
DEMO_USER_NAME=Alex Rivera
DEMO_USER_EMAIL=alex@roleroute.demo

# LLM provider for SAM: gemini | openai | none
# If no API key is set, SAM always runs in demo mode.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
